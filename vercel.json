{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["hnd1"],
  "crons": [
    { "path": "/api/cron/notify?slot=morning", "schedule": "0 3 * * *" },
    { "path": "/api/cron/notify?slot=afternoon", "schedule": "0 9 * * *" },
    { "path": "/api/cron/notify?slot=evening", "schedule": "30 14 * * *" },
    { "path": "/api/cron/community-cleanup", "schedule": "0 20 * * *" },
    { "path": "/api/cron/leaderboard-reconcile", "schedule": "30 20 * * *" }
  ],
  "functions": {
    "api/cron/notify.js": { "maxDuration": 60 },
    "api/cron/community-cleanup.js": { "maxDuration": 30 },
    "api/cron/leaderboard-reconcile.js": { "maxDuration": 60 },
    "api/push/subscribe.js": { "maxDuration": 10 },
    "api/push/unsubscribe.js": { "maxDuration": 10 },
    "api/push/test.js": { "maxDuration": 30 },
    "api/ai/insights.js": { "maxDuration": 30 },
    "api/ai/revision.js": { "maxDuration": 30 },
    "api/ai/buddy.js": { "maxDuration": 30 },
    "api/ai/mock-compare.js": { "maxDuration": 30 },
    "api/ai/status.js": { "maxDuration": 10 }
  }
}
